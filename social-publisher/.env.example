PORT=3000
# Publishing mode: 'sandbox' simulates official API responses; 'live' calls official platform APIs.
PUBLISH_MODE=sandbox
# Publicly accessible base URL of this server (required by Instagram & Google Business Profile to fetch images).
PUBLIC_BASE_URL=http://localhost:3000

# Facebook Page + Instagram Business Account (Meta Graph API v21.0)
META_PAGE_ID=
META_PAGE_TOKEN=
META_IG_USER_ID=

# LinkedIn Community Management / Share API (w_member_social or w_organization_social)
LINKEDIN_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_VERSION=202511

# Google Business Profile API (OAuth2 Refresh Token + Account & Location IDs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMB_ACCOUNT_ID=
GMB_LOCATION_ID=
